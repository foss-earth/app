  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "ci": "npm run check:conformance && npm run check:implementation",
    "deploy": "npm run deploy:gh-pages",
    "deploy:gh-pages": "npm run build && gh-pages -d dist",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.app.tsbuildinfo && tsc -p tsconfig.node.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.node.tsbuildinfo",
    "test": "vitest run --maxWorkers=50%",
    "test:changed": "vitest related --run --maxWorkers=50%",
    "test:watch": "vitest",
    "check:conformance": "node node_modules/@foss-earth/ci/bin/conformance.mjs --consumer . --trusted-release .attribution-release.json --output-root build/common-conformance",
    "check:attribution": "node node_modules/@foss-earth/ci/bin/attribution.mjs --repo . --refs-file build/repository-split/intended-publication-refs.json",
    "check:ownership": "node scripts/check-ownership.mjs",
    "check:implementation": "npm run check:ownership && npm run lint && npm test && npm run build",
    "setup": "node scripts/setup.mjs"
  },
