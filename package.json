{
  "name": "foss-earth",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./shell": "./src/shell/index.ts",
    "./input": "./src/input/public.ts",
    "./input-mode.css": "./src/styles/input-mode.css",
    "./shell.css": "./src/styles/shell.css",
    "./windowing": "./src/compat/windowing.ts",
    "./windowing.css": "./src/styles/windowing.css",
    "./layers": "./src/compat/layers.ts",
    "./lights": "./src/compat/lights.ts",
    "./cameraMath": "./src/compat/cameraMath.ts",
    "./diagnostics": "./src/diagnostics/index.ts",
    "./heights": "./src/compat/heights.ts",
    "./diagnosticDrawing": "./src/compat/diagnosticDrawing.ts",
    "./mapDetailPolicy": "./src/compat/mapDetailPolicy.ts",
    "./perf": "./src/compat/perf.ts",
    "./scenes": "./src/scenes/index.ts",
    "./scenes/schema.json": "./schema/scene-1.json",
    "./settings": "./src/settings/index.ts",
    "./sky": "./src/compat/sky.ts",
    "./weather": "./src/compat/weather.ts",
    "./smoothElevation": "./src/compat/smoothElevation.ts",
    "./style.css": "./src/styles/globe.css",
    "./vite": "./vite/index.ts"
  },
  "bin": {},
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "npm run typecheck && vite build --configLoader native",
    "ci": "npm run check:implementation",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc -p tsconfig.app.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.app.tsbuildinfo && tsc -p tsconfig.node.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.node.tsbuildinfo",
    "test": "vitest run --configLoader native --maxWorkers=50% --exclude scripts/validation/browser-functional.test.mjs",
    "test:changed": "vitest related --run --configLoader native --maxWorkers=50%",
    "test:watch": "vitest --configLoader native",
    "check:implementation": "npm run lint && npm test && npm run test:browser-assertions && npm run build",
    "test:browser-assertions": "node --test --test-concurrency=1 scripts/validation/browser-functional.test.mjs",
    "check:browser": "node scripts/validation/browser-functional.mjs"
  },
  "dependencies": {
    "@foss-earth/ui": "file:../ui",
    "@foss-earth/renderer": "file:../renderer",
    "@foss-earth/engine": "file:../engine",
    "@foss-earth/toolbar": "file:../toolbar",
    "@foss-earth/about": "file:../about",
    "@foss-earth/dev": "file:../dev",
    "@foss-earth/sky": "file:../sky",
    "@foss-earth/weather": "file:../weather",
    "@foss-earth/images": "file:../images",
    "@foss-earth/rectangle-image": "file:../rectangle-image",
    "@foss-earth/sphere-image": "file:../sphere-image",
    "@foss-earth/scenes": "file:../scenes",
    "@foss-earth/sphere-cubemap": "file:../sphere-cubemap",
    "@foss-earth/sphere-equirectangular": "file:../sphere-equirectangular",
    "@foss-earth/sphere-tiled-cubemap": "file:../sphere-tiled-cubemap",
    "@foss-earth/preview-sheets": "file:../preview-sheets",
    "@felipegalind0/gamepad-tools": "file:../../Felipegalind0/gamepad-tools",
    "@babylonjs/core": "8.56.2",
    "@babylonjs/loaders": "8.56.2",
    "3d-tiles-renderer": "0.4.24",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "ajv": "8.20.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "gh-pages": "6.3.0",
    "globals": "17.6.0",
    "jpeg-js": "0.4.4",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.4",
    "vitest": "4.1.6",
    "@foss-earth/browser-testing": "file:../browser-testing"
  },
  "description": "Standalone Earth application and compatibility composition over independent public globe providers.",
  "repository": {
    "type": "git",
    "url": "https://github.com/foss-earth/app.git"
  },
  "files": [
    "src",
    "vite",
    "schema",
    "public",
    "index.html",
    "vite.config.ts",
    "tsconfig*.json",
    "README.md",
    "LICENSE",
    "COMMERCIAL_LICENSE.md",
    "NOTICE",
    "AGENTS.md",
    "docs",
    "scripts/check-installed-app.mjs",
    "fixtures/public-app-consumer"
  ]
}
